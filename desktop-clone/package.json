{
  "name": "tinygpt-voice-clone",
  "version": "0.1.0-prebeta.3",
  "private": true,
  "description": "TinyGPT private desktop AI companion with included local intelligence and voice",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "npm run handbook:check && npm run runtime:rag && npm run runtime:dictation && npm run runtime:computer && npm run runtime:passwords && npm run runtime:work && npm run runtime:vision && electron-vite dev",
    "build": "npm run handbook:check && npm run runtime:rag && npm run runtime:dictation && npm run runtime:computer && npm run runtime:passwords && npm run runtime:work && npm run typecheck && npm run runtime:vision && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "harness:audit": "node scripts/harness-audit.cjs",
    "harness:audit:types": "tsc -p scripts/tsconfig.harness-audit.json --noEmit",
    "test:computer:native": "node scripts/computer-native-smoke.cjs",
    "test:computer:model": "node scripts/computer-native-smoke.cjs --model",
    "test:computer:electron": "electron scripts/computer-electron-smoke.cjs",
    "test:speech:native": "node scripts/speech-native-smoke.cjs",
    "preview": "electron-vite preview",
    "runtime:dictation": "node scripts/prepare-voice-runtime.mjs && node scripts/prepare-pocket-tts.mjs",
    "package:win": "npm run runtime:dictation && npm run build && npm run models:catalog && electron-builder --win",
    "package:mac": "npm run runtime:dictation && npm run build && npm run models:catalog && electron-builder --mac",
    "runtime:rag": "node scripts/prepare-rag-runtime.mjs",
    "runtime:voice": "node scripts/prepare-voice-runtime.mjs && node scripts/prepare-pocket-tts.mjs",
    "runtime:computer": "node scripts/prepare-computer-runtime.mjs",
    "remote:build": "node scripts/prepare-mobile-assets.mjs && vite build --config remote-relay/vite.config.ts",
    "remote:typecheck": "tsc -p remote-relay/tsconfig.json",
    "remote:dev": "wrangler dev --config remote-relay/wrangler.jsonc",
    "remote:deploy": "npm run remote:build && wrangler deploy --config remote-relay/wrangler.jsonc",
    "remote:smoke": "node scripts/remote-chat-smoke.mjs",
    "runtime:vision": "node scripts/prepare-vision-runtime.mjs",
    "test:vision:local": "node scripts/local-vision-smoke.cjs",
    "remote:push:setup": "node scripts/setup-remote-push.mjs",
    "test:work:pro": "node scripts/pro-work-smoke.cjs",
    "test:work:pi": "node scripts/pi-work-smoke.cjs",
    "test:work:browser": "node scripts/work-browser-smoke.cjs",
    "test:work:runtimes": "node scripts/work-runtimes-smoke.cjs",
    "test:work:runtimes:package": "node scripts/work-runtimes-package-smoke.cjs",
    "runtime:work": "node scripts/prepare-work-tools.mjs && node scripts/prepare-work-runtimes.mjs",
    "plugins:build": "node scripts/prepare-connector-web-assets.mjs",
    "plugins:typecheck": "tsc -p plugin-auth/tsconfig.json",
    "plugins:deploy": "npm run plugins:build && npm run plugins:typecheck && wrangler deploy --config plugin-auth/wrangler.jsonc",
    "connectors:release-check": "node scripts/check-connector-release.mjs",
    "test:bot:pi": "node scripts/pi-bot-scheduled-smoke.cjs",
    "handbook:build": "node scripts/handbook.cjs",
    "handbook:check": "node scripts/handbook.cjs --check",
    "runtime:passwords": "node scripts/prepare-password-runtime.mjs",
    "models:catalog": "node scripts/prepare-model-assets.mjs",
    "release:check": "node scripts/verify-release.mjs",
    "release:preflight": "node scripts/release-preflight.cjs",
    "release:win": "npm run release:preflight && npm run runtime:dictation && npm run build && npm run models:catalog && electron-builder --win --config scripts/release-builder.cjs --publish never && npm run release:check",
    "release:publish": "node scripts/publish-release.mjs",
    "source:audit": "node scripts/audit-public-source.mjs",
    "secrets:check": "node scripts/check-secrets.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.3.0",
    "@assistant-ui/react": "^0.15.26",
    "@assistant-ui/react-markdown": "0.14.20",
    "@block65/webcrypto-web-push": "2.0.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/merge": "^6.12.2",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@huggingface/transformers": "4.3.1",
    "@json-render/core": "0.21.4",
    "@json-render/react": "0.21.4",
    "@librechat/agents": "4.0.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/canvas": "1.0.10",
    "@opencode-ai/sdk": "1.18.35",
    "@radix-ui/react-context-menu": "2.3.8",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "^1.1.24",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-scroll-area": "1.3.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "8.20.0",
    "assistant-stream": "0.3.49",
    "b4a": "1.8.0",
    "beautiful-mermaid": "1.1.3",
    "blob-avatar": "2.2.0",
    "chrome-devtools-mcp": "1.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "6.0.2",
    "diff": "9.0.0",
    "docx-preview": "0.3.6",
    "electron-updater": "6.8.11",
    "exceljs": "4.4.0",
    "ignore": "7.0.5",
    "jszip": "3.10.2",
    "koffi": "2.14.1",
    "mathjs": "15.2.0",
    "noise-handshake": "4.2.0",
    "opencode-ai": "1.18.35",
    "pdfjs-dist": "6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-colorful": "5.6.1",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "react-shiki": "0.11.2",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "sodium-javascript": "0.8.0",
    "sqlite-vec": "0.1.9",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "6.0.1",
    "undici": "7.30.1",
    "ws": "^8.22.0",
    "yaml": "2.9.1",
    "zod": "^4.3.6",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/lib-storage": "3.1164.0",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@solar-icons/react": "2.3.3",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.5.1",
    "electron-builder": "26.18.1",
    "electron-vite": "^5.0.0",
    "jsqr": "^1.4.0",
    "playwright": "^1.64.1",
    "secretlint": "13.1.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.156.2"
  },
  "license": "Apache-2.0"
}
